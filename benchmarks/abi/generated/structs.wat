(module
      (type $item (struct (field (mut f32)) (field (mut f32)) (field (mut f32)) (field (mut f32)) (field (mut f32)) (field (mut f32))))
(type $items (array (mut (ref null $item))))
      (import "abi" "submit" (func $submit (param i32 (ref null $items))))
      (global $items (mut (ref null $items)) (ref.null $items))
      (global $n (mut i32) (i32.const 0))
      (global $tick (mut i32) (i32.const 0))
      (func $build (param $seed i32) (local $i i32) (local $obj (ref null $item))
        (local.set $i (i32.const 0))
        (block $done (loop $loop
          (br_if $done (i32.ge_u (local.get $i) (global.get $n)))
          (local.set $obj (array.get $items (global.get $items) (local.get $i)))
(struct.set $item 0 (ref.as_non_null (local.get $obj)) (f32.convert_i32_u (local.get $i)))
(struct.set $item 1 (ref.as_non_null (local.get $obj)) (f32.const 2))
(struct.set $item 2 (ref.as_non_null (local.get $obj)) (f32.add (f32.const 640) (f32.convert_i32_u (local.get $seed))))
(struct.set $item 3 (ref.as_non_null (local.get $obj)) (f32.const 480))
(struct.set $item 4 (ref.as_non_null (local.get $obj)) (f32.const 0))
(struct.set $item 5 (ref.as_non_null (local.get $obj)) (f32.const 1))
          (local.set $i (i32.add (local.get $i) (i32.const 1)))
          (br $loop))))
      (func (export "init") (param $count i32) (local $i i32)
        (global.set $n (local.get $count))
        (global.set $tick (i32.const 0))
        (global.set $items (array.new_default $items (global.get $n)))(local.set $i (i32.const 0))
        (block $done (loop $loop
          (br_if $done (i32.ge_u (local.get $i) (global.get $n)))
          (array.set $items (global.get $items) (local.get $i) (struct.new $item (f32.convert_i32_u (local.get $i)) (f32.const 2) (f32.add (f32.const 640) (f32.convert_i32_u (i32.const 0))) (f32.const 480) (f32.const 0) (f32.const 1)))
          (local.set $i (i32.add (local.get $i) (i32.const 1)))
          (br $loop)))
        )
      (func $bridge (export "bridge")
        (call $submit (global.get $n) (global.get $items)))
      (func $update (export "update_only") (local $i i32)
        (global.set $tick (i32.and (i32.add (global.get $tick) (i32.const 1)) (i32.const 1023)))
        (local.set $i (i32.const 0))
        (block $done (loop $loop
          (br_if $done (i32.ge_u (local.get $i) (global.get $n)))
          (struct.set $item 2 (ref.as_non_null (array.get $items (global.get $items) (local.get $i))) (f32.add (f32.const 640) (f32.convert_i32_u (global.get $tick))))
          (local.set $i (i32.add (local.get $i) (i32.const 1)))
          (br $loop))))
      (func (export "update") (call $update) (call $bridge))
      (func $rebuild (export "rebuild_only")
        (global.set $tick (i32.and (i32.add (global.get $tick) (i32.const 1)) (i32.const 1023)))
        (call $build (global.get $tick)))
      (func (export "rebuild") (call $rebuild) (call $bridge))
      (func (export "construct") (local $i i32)
        (global.set $tick (i32.and (i32.add (global.get $tick) (i32.const 1)) (i32.const 1023)))
        (global.set $items (array.new_default $items (global.get $n)))(local.set $i (i32.const 0))
        (block $done (loop $loop
          (br_if $done (i32.ge_u (local.get $i) (global.get $n)))
          (array.set $items (global.get $items) (local.get $i) (struct.new $item (f32.convert_i32_u (local.get $i)) (f32.const 2) (f32.add (f32.const 640) (f32.convert_i32_u (global.get $tick))) (f32.const 480) (f32.const 0) (f32.const 1)))
          (local.set $i (i32.add (local.get $i) (i32.const 1)))
          (br $loop)))
        (call $bridge))
      (func (export "tick") (result i32) (global.get $tick))
    )
