(module
      (type $items (array (mut i32)))
      (import "abi" "submit" (func $submit (param i32 (ref null $items))))
      (global $items (mut (ref null $items)) (ref.null $items))
      (global $n (mut i32) (i32.const 0))
      (global $tick (mut i32) (i32.const 0))
      (func $build (param $seed i32) (local $i i32)
        (local.set $i (i32.const 0))
        (block $done (loop $loop
          (br_if $done (i32.ge_u (local.get $i) (global.get $n)))
          (array.set $items (global.get $items) (i32.add (i32.mul (local.get $i) (i32.const 6)) (i32.const 0)) (i32.reinterpret_f32 (f32.convert_i32_u (local.get $i))))
(array.set $items (global.get $items) (i32.add (i32.mul (local.get $i) (i32.const 6)) (i32.const 1)) (i32.reinterpret_f32 (f32.const 2)))
(array.set $items (global.get $items) (i32.add (i32.mul (local.get $i) (i32.const 6)) (i32.const 2)) (i32.reinterpret_f32 (f32.add (f32.const 640) (f32.convert_i32_u (local.get $seed)))))
(array.set $items (global.get $items) (i32.add (i32.mul (local.get $i) (i32.const 6)) (i32.const 3)) (i32.reinterpret_f32 (f32.const 480)))
(array.set $items (global.get $items) (i32.add (i32.mul (local.get $i) (i32.const 6)) (i32.const 4)) (i32.reinterpret_f32 (f32.const 0)))
(array.set $items (global.get $items) (i32.add (i32.mul (local.get $i) (i32.const 6)) (i32.const 5)) (i32.reinterpret_f32 (f32.const 1)))
          (local.set $i (i32.add (local.get $i) (i32.const 1)))
          (br $loop))))
      (func (export "init") (param $count i32) (local $i i32)
        (global.set $n (local.get $count))
        (global.set $tick (i32.const 0))
        (global.set $items (array.new_default $items (i32.mul (global.get $n) (i32.const 6))))
        (call $build (i32.const 0)))
      (func $bridge (export "bridge")
        (call $submit (global.get $n) (global.get $items)))
      (func $update (export "update_only") (local $i i32)
        (global.set $tick (i32.and (i32.add (global.get $tick) (i32.const 1)) (i32.const 1023)))
        (local.set $i (i32.const 0))
        (block $done (loop $loop
          (br_if $done (i32.ge_u (local.get $i) (global.get $n)))
          (array.set $items (global.get $items) (i32.add (i32.mul (local.get $i) (i32.const 6)) (i32.const 2)) (i32.reinterpret_f32 (f32.add (f32.const 640) (f32.convert_i32_u (global.get $tick)))))
          (local.set $i (i32.add (local.get $i) (i32.const 1)))
          (br $loop))))
      (func (export "update") (call $update) (call $bridge))
      (func $rebuild (export "rebuild_only")
        (global.set $tick (i32.and (i32.add (global.get $tick) (i32.const 1)) (i32.const 1023)))
        (call $build (global.get $tick)))
      (func (export "rebuild") (call $rebuild) (call $bridge))
      (func (export "construct") (local $i i32)
        (global.set $tick (i32.and (i32.add (global.get $tick) (i32.const 1)) (i32.const 1023)))
        (global.set $items (array.new_default $items (i32.mul (global.get $n) (i32.const 6))))(call $build (global.get $tick))
        (call $bridge))
      (func (export "tick") (result i32) (global.get $tick))
    )
